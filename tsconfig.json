{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "./.nuxt/nuxt.d.ts",
    "./app/**/*",
    "./server/**/*",
    "./tests/**/*.spec.ts",
    "./tests/**/*.test.ts",
    "./types/**/*.ts"
  ],
  "exclude": ["tests/e2e"]
}
